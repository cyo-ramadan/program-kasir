{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototype-leker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maxi-db",
      "database_id": "363b2f8d-f036-4def-bd9b-f04b0d20dc1f",
      "migrations_dir": "migrations"
    }
  ]
}
