{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototype-leker",
  "main": "worker.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_STORE",
        "class_name": "OrderStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderStore"]
    }
  ]
}
